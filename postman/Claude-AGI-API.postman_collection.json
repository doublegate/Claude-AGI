        {
          "name": "Get Recent Thoughts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/thoughts/recent?limit=10",
              "host": ["{{base_url}}"],
              "path": ["thoughts", "recent"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of thoughts to retrieve"
                }
              ]
            },
            "description": "Retrieve recently generated thoughts"
          },
          "response": []
        },
        {
          "name": "Get Recent Thoughts - Filtered by Stream",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/thoughts/recent?limit=5&stream_type=META",
              "host": ["{{base_url}}"],
              "path": ["thoughts", "recent"],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "stream_type",
                  "value": "META",
                  "description": "Filter by consciousness stream"
                }
              ]
            },
            "description": "Retrieve recent thoughts from a specific stream"
          },
          "response": []
        }
      ],
      "description": "Thought generation and consciousness stream management"
