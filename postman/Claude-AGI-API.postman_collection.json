            "body": {
              "mode": "raw",
              "raw": "{\n  \"stream_type\": \"CREATIVE\",\n  \"context\": {\n    \"theme\": \"innovation\",\n    \"domain\": \"AI\"\n  },\n  \"emotional_state\": \"EXCITED\"\n}"
