              "raw": "{\n  \"stream_type\": \"PRIMARY\",\n  \"context\": {\n    \"topic\": \"consciousness\",\n    \"depth\": \"moderate\"\n  },\n  \"emotional_state\": \"CURIOUS\"\n}"
            },
            "url": {
