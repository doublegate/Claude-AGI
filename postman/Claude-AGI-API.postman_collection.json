    {
      "name": "Conversation",
      "item": [
        {
          "name": "Start Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"conversation_id\", jsonData.conversation_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello! Tell me about your understanding of consciousness.\",\n  \"emotional_context\": \"CURIOUS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/conversation",
              "host": ["{{base_url}}"],
              "path": ["conversation"]
            },
            "description": "Start a new conversation (saves conversation_id for continuation)"
          },
          "response": []
        },
        {
          "name": "Continue Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"That's fascinating. Can you elaborate on that?\",\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"emotional_context\": \"INTERESTED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/conversation",
              "host": ["{{base_url}}"],
              "path": ["conversation"]
            },
            "description": "Continue an existing conversation using saved conversation_id"
          },
          "response": []
        },
        {
          "name": "Philosophical Conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What do you think about the nature of subjective experience?\",\n  \"emotional_context\": \"CONTEMPLATIVE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/conversation",
              "host": ["{{base_url}}"],
              "path": ["conversation"]
            },
            "description": "Example of a philosophical conversation"
          },
          "response": []
        }
